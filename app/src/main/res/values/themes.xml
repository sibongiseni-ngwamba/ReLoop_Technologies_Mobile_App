<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ReLoop_Technologies_Mobile_App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/ReLoopActivityAnimations</item>
    </style>

    <style name="ReLoopActivityAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/page_in_from_right</item>
        <item name="android:activityOpenExitAnimation">@anim/page_out_to_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_in_from_left</item>
        <item name="android:activityCloseExitAnimation">@anim/page_out_to_right</item>
    </style>

    <style name="Theme.ReLoop_Technologies_Mobile_App" parent="Base.Theme.ReLoop_Technologies_Mobile_App" />
</resources>
